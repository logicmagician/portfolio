# Copy to .env.local for local builds. Never commit real values.
#
# Two kinds of variable:
#   NEXT_PUBLIC_*  Visible to every visitor in the built site. Only endpoint IDs and public IDs go here.
#   Everything else is read only at build time on the server. Put secrets in GitHub Actions secrets.

# ---- Build-time integrations (server only) ----
# Public GitHub username whose repositories appear on /projects.
GITHUB_USERNAME=
# Optional. Raises the GitHub API rate limit. Use a fine-grained token with read-only public access.
GITHUB_TOKEN=
# ORCID iD (0000-0000-0000-0000). Public record; used on /research.
ORCID_ID=
# Optional contact email sent in the Crossref User-Agent header.
CROSSREF_MAILTO=
# Dev.to username, for future article listings.
DEVTO_USERNAME=

# ---- Public configuration (visible in the built site) ----
# External form endpoint, for example https://formspree.io/f/your-form-id. Empty shows the email fallback.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Empty keeps analytics off.
NEXT_PUBLIC_ANALYTICS_ID=
